<UserControl x:Class="Developer_Helper_prism.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
             xmlns:local="clr-namespace:Developer_Helper_prism.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Style="{StaticResource ThemeStackpanel}">

        <markdig:MarkdownViewer x:Name="MarkdownViewer" Markdown="{Binding MarkdownContent}"/>
    </StackPanel>
</UserControl>
