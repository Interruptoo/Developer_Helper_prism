<Window x:Class="Developer_Helper_prism.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}" Height="700" Width="1250" MinHeight="250" MinWidth="500" >

    <Window.Resources>
        <ResourceDictionary>

            <!--<Style TargetType="{x:Type Button}">
                --><!--<Setter Property="FontSize" Value="12"/>--><!--
                <Setter Property="Foreground" Value="Black" />
                --><!--<Setter Property="VerticalAlignment" Value="Center"/>--><!--

                <Style.Triggers>
                    <Trigger Property="IsMouseDirectlyOver" Value="True">
                        --><!--<Setter Property="Foreground" Value="White"/>--><!--
                        <Setter Property="Background" Value="#0274ad"/>
                    </Trigger>
                    <Trigger Property="IsFocused" Value="True">
                        <Setter Property="Background" Value="#0274ad"/>
                        --><!--<Setter Property="Foreground" Value="White"/>--><!--
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Trigger>
                </Style.Triggers>
            </Style>-->
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Left Menu Bar -->
        <ItemsControl ItemsSource="{Binding MenuCollection}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding MenuName}" ToolTip="{Binding MenuTooltip}">
                        <StackPanel>
                            <Image Width="20" Height="20" Source="{Binding MenuIcon}"/>
                            <TextBlock Text="{Binding MenuTitle}"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        
        <ContentControl Grid.Column="1" prism:RegionManager.RegionName="ContentRegion" />
    </Grid>
</Window>
