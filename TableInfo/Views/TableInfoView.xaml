                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Button Click="BtnOpenPLEdit_Click" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Height="16" Width="16"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0" ToolTip="PLEdit로 소스코드를 조회합니다." >
                            <StackPanel Orientation="Horizontal">
                                <Image Width="14" Height="16" Source="/DH;component/Images/Icon/edit-redo.png" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" />
