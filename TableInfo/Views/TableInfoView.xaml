                    Style="{StaticResource ThemeStackpanel}">
            <!--<TextBox Height="20" Margin="5,1,0,0" MinWidth="160" VerticalContentAlignment="Center" Tag="키워드1, 키워드2" Style="{StaticResource HintedTextBox}"/>-->
            <uc:DHTextBox x:Name="txtKeywordCol"
                          Height="20"
                          MinWidth="160"
                          Margin="5,1,0,0"
                          ClearButtonVisibility="Visible"
                          Watermark="키워드1||키워드2" />

            <!--<ComboBox x:Name="cboAndOrCol"
                      Grid.Column="1"
                      Width="55"
                      Height="20"
                      Margin="0,1,0,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      SelectedIndex="0"
                      SelectedValuePath="Content">
                <ComboBoxItem Content="AND" IsSelected="True" />
                <ComboBoxItem Content="OR" />
            </ComboBox>-->
        </StackPanel>
        <DockPanel Grid.Column="4"
                   LastChildFill="False"
                   Style="{StaticResource ThemeDockPanel}">
