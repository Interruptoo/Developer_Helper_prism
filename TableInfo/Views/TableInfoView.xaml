            <uc:DHTextBox x:Name="txtKeywordObj"
                          Height="20"
                          MinWidth="160"
                          Margin="5,1,0,0"
                          ClearButtonVisibility="Visible"
                          Watermark="키워드1||키워드2" />
            <!--<ComboBox x:Name="cboAndOrObj"
                      Grid.Column="1"
                      Width="55"
                      Height="20"
                      Margin="0,1,0,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      SelectedIndex="0"
                      SelectedValuePath="Content">
                <ComboBoxItem Content="AND" IsSelected="True" />
                <ComboBoxItem Content="OR" />
            </ComboBox>-->

            <!--<Button x:Name="BtnSelect"
                    Grid.Column="4"
                    Width="64"
                    Height="25"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal">
                    <Image Width="21"
                           Height="21"
                           Margin="5,0,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Source="/Core;component/Image/Icon/Find.png" />
                    <TextBlock Margin="5,0,5,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Text="조회"
                               TextWrapping="WrapWithOverflow" />
                </StackPanel>
            </Button>-->
        </DockPanel>

        <!--  row 1 col 0  -->
        <Grid Grid.Row="1" Background="#F0F0F0">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="0.5*" />
            </Grid.RowDefinitions>
            <TabControl x:Name="tabMain"
                        Margin="0,-2,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        BorderBrush="#696969"
                        BorderThickness="0,1,0,0"
                        SelectedIndex="0">
                <!--  HeaderTemplate="{StaticResource Tab_Header}" Style="{StaticResource TabItemDepth2}"  -->
                <TabItem Header="전체">
                    <DataGrid x:Name="dgdObjList"
                              MaxHeight="1500"
                              Margin="0,5,5,5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              AllowDrop="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              EnableColumnVirtualization="True"
                              EnableRowVirtualization="True"
                              HorizontalGridLinesBrush="#FFD5D5D5"
                              ItemsSource="{Binding _tableInfo}"
                              ScrollViewer.CanContentScroll="True"
                              VerticalGridLinesBrush="#FFD5D5D5"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              VirtualizingPanel.VirtualizationMode="Standard">
                        <DataGrid.ContextMenu>
                            <ContextMenu>

                                <MenuItem>
                                    <MenuItem.Icon>
                                        <Image Source="/Core;component/Image/Icon/icon_wand.gif" />
                                    </MenuItem.Icon>
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Label Content="즐겨찾기 추가" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem>
                                    <MenuItem.Icon>
                                        <Image Source="/Core;component/Image/Icon/icon_wand.gif" />
                                    </MenuItem.Icon>
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Label Content="DDL Create" />
                                            <!--<uc:DHTextBox Width="30" Name="tbInsertAlias" Margin="2,0,0,0" Height="20" />-->
                                            <Label Content="Alias" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>

                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTextColumn Width="50"
                                                Binding="{Binding OWNER}"
                                                Header="OWNER" />
                            <DataGridTextColumn Width="80"
                                                Binding="{Binding TABLE_NAME}"
                                                FontWeight="Bold"
                                                Header="TABLE" />
                            <DataGridTextColumn Width="*"
                                                Binding="{Binding TABLE_COMMENTS}"
                                                FontSize="10"
                                                Header="TABLE COMMENTS" />
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="16"
                                                Height="16"
                                                Margin="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                ToolTip="SELECT 쿼리를 복사합니다.">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Width="16"
                                                       Height="16"
                                                       Margin="0,0,0,0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Source="/Core;component/Image/Icon/My-Documents-Inside-Green-128.png" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="16"
                                                Height="16"
                                                Margin="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                ToolTip="SELECT 쿼리를 복사합니다. (매개변수 포함)">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Width="16"
                                                       Height="16"
                                                       Margin="0,0,0,0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Source="/Core;component/Image/Icon/My-Documents-Inside-Green-128.png" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="16"
                                                Height="16"
                                                Margin="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                ToolTip="데이터를 조회합니다.">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Width="14"
                                                       Height="16"
                                                       Margin="0,0,0,0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Source="/Core;component/Image/Icon/edit-redo.png" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Width="30"
                                                Binding="{Binding CREATED_DAYS}"
                                                Header="CREATED_DAYS"
                                                Visibility="Collapsed" />
                            <DataGridTextColumn Width="30"
                                                Binding="{Binding MODIFY_DAYS}"
                                                Header="MODIFY_DAYS"
                                                Visibility="Collapsed" />
                            <!--  CellStyle="{StaticResource CellStyleCenter}"  -->
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" />
                        </DataGrid.RowStyle>
                    </DataGrid>
                </TabItem>
                <!--  HeaderTemplate="{StaticResource Tab_Header}" Style="{StaticResource TabItemDepth2}"  -->
                <TabItem x:Name="grdFav" Header="즐겨찾기">
                    <DataGrid x:Name="dgdFavObjList"
                              MaxHeight="1500"
                              Margin="0,5,5,5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              AllowDrop="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              EnableColumnVirtualization="True"
                              EnableRowVirtualization="True"
                              HorizontalGridLinesBrush="#FFD5D5D5"
                              ScrollViewer.CanContentScroll="True"
                              VerticalGridLinesBrush="#FFD5D5D5"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              VirtualizingPanel.VirtualizationMode="Standard">
                        <DataGrid.ContextMenu>
                            <ContextMenu>

                                <MenuItem>
                                    <MenuItem.Icon>
                                        <Image Source="/Core;component/Image/Icon/icon_wand.gif" />
                                    </MenuItem.Icon>
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Label Content="DDL Create" />
                                            <!--<uc:DHTextBox Width="30" Name="tbInsertAlias" Margin="2,0,0,0" Height="20" />
    <Label Content="Alias" />-->
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>


                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTextColumn Width="50"
                                                Binding="{Binding OWNER}"
                                                Header="OWNER" />
                            <DataGridTextColumn Width="80"
                                                Binding="{Binding TABLE_NAME}"
                                                FontWeight="Bold"
                                                Header="TABLE" />
                            <DataGridTextColumn Width="*"
                                                Binding="{Binding TABLE_COMMENTS}"
                                                FontSize="10"
                                                Header="TABLE COMMENTS" />
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="16"
                                                Height="16"
                                                Margin="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                ToolTip="SELECT 쿼리를 복사합니다.">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Width="16"
                                                       Height="16"
                                                       Margin="0,0,0,0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Source="/Core;component/Image/Icon/My-Documents-Inside-Green-128.png" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="16"
                                                Height="16"
                                                Margin="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                ToolTip="SELECT 쿼리를 복사합니다. (매개변수 포함)">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Width="16"
                                                       Height="16"
                                                       Margin="0,0,0,0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Source="/Core;component/Image/Icon/My-Documents-Inside-Green-128.png" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="16"
                                                Height="16"
                                                Margin="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                ToolTip="데이터를 조회합니다.">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Width="14"
                                                       Height="16"
                                                       Margin="0,0,0,0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Source="/Core;component/Image/Icon/edit-redo.png" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Width="30"
                                                Binding="{Binding CREATED_DAYS}"
                                                Header="CREATED_DAYS"
                                                Visibility="Collapsed" />
                            <DataGridTextColumn Width="30"
                                                Binding="{Binding MODIFY_DAYS}"
                                                Header="MODIFY_DAYS"
                                                Visibility="Collapsed" />
                            <!--  CellStyle="{StaticResource CellStyleCenter}"  -->
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" />
                        </DataGrid.RowStyle>
                    </DataGrid>
                </TabItem>
            </TabControl>
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Panel.ZIndex="100"
                        Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=SelectedIndex, ElementName=tabMain}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>


                <Button x:Name="BtnUp"
                        Grid.Column="2"
                        Width="20"
                        Height="20"
                        Margin="2,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="14"
                               Height="14"
                               Margin="0,0,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Source="/Core;component/Image/Icon/arrow2_n.gif" />

                        <TextBlock Margin="5,0,5,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Text=""
                                   TextWrapping="WrapWithOverflow" />

                    </StackPanel>
                </Button>
                <Button x:Name="BtnDown"
                        Grid.Column="2"
                        Width="20"
                        Height="20"
                        Margin="2,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="14"
                               Height="14"
                               Margin="0,0,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Source="/Core;component/Image/Icon/arrow2_s.gif" />

                        <TextBlock Margin="5,0,5,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Text=""
                                   TextWrapping="WrapWithOverflow" />

                    </StackPanel>
                </Button>
                <Button x:Name="BtnDelete"
                        Grid.Column="2"
                        Width="20"
                        Height="20"
                        Margin="2,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="14"
                               Height="14"
                               Margin="0,0,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Source="/Core;component/Image/Icon/subtract.gif" />

                        <TextBlock Margin="5,0,5,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Text=""
                                   TextWrapping="WrapWithOverflow" />

                    </StackPanel>
                </Button>
                <Button x:Name="BtnSave"
                        Grid.Column="2"
                        Width="20"
                        Height="20"
                        Margin="2,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        ToolTip="저장합니다.">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="14"
                               Height="14"
                               Margin="0,0,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Source="/Core;component/Image/Icon/document-save16.png" />

                        <TextBlock Margin="5,0,5,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Text=""
                                   TextWrapping="WrapWithOverflow" />

                    </StackPanel>
                </Button>

                <Button x:Name="BtnReload"
                        Grid.Column="2"
                        Width="20"
                        Height="20"
                        Margin="2,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        ToolTip="새로고침">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="14"
                               Height="14"
                               Margin="0,0,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Source="/Core;component/Image/Icon/reload.gif" />

                        <TextBlock Margin="5,0,5,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Text=""
                                   TextWrapping="WrapWithOverflow" />

                    </StackPanel>
                </Button>
            </StackPanel>

            <GridSplitter Grid.Row="1"
                          Width="Auto"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center" />
            <DataGrid Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="100" Header="INDEX NAME" />
                    <DataGridTextColumn Width="100" Header="COLUMN" />
                    <DataGridTextColumn Width="*" Header="COMMENT" />
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="3"
                          Width="Auto"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center" />
            <DataGrid Grid.Row="4" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="100" Header="STATUS" />
                    <DataGridTextColumn Width="*" Header="VALUE" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <!--  row 1 col 1  -->
        <GridSplitter Grid.Row="0"
                      Grid.RowSpan="2"
                      Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" />
        <!--  row 1 col 2  -->
        <Grid Grid.Row="1"
              Grid.Column="2"
              Background="#F0F0F0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DataGrid>
                <DataGrid.Columns>
                    <DataGridTextColumn Width="100" Header="COLUMN" />
                    <DataGridTextColumn Width="40" Header="NULL" />
                    <DataGridTextColumn Width="80" Header="DATA TYPE" />
                    <DataGridTextColumn Width="*" Header="COMMENT" />
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1"
                          Width="Auto"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center" />
            <DataGrid Grid.Row="2"
                      HorizontalAlignment="Stretch"
                      AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="90"
                                        Binding="{Binding COMN_GRP_CD}"
                                        Header="COMN_GRP_CD" />
                    <DataGridTextColumn Width="80"
                                        Binding="{Binding COMN_CD}"
                                        Header="COMN_CD" />
                    <DataGridTextColumn Width="200"
                                        Binding="{Binding COMN_CD_NM}"
                                        Header="COMN_CD_NM" />
                    <DataGridTextColumn Width="200"
                                        Binding="{Binding COMN_CD_EXPL}"
                                        Header="COMN_CD_EXPL" />
                    <DataGridTextColumn Width="50"
                                        Binding="{Binding SCRN_MRK_SEQ}"
                                        Header="SORT" />
                    <DataGridTextColumn Width="50"
                                        Binding="{Binding USE_YN}"
                                        Header="USE_YN" />

                    <DataGridTextColumn Width="120"
                                        Binding="{Binding DTRL1_NM}"
                                        Header="DTRL1_NM" />
                    <DataGridTextColumn Width="120"
                                        Binding="{Binding DTRL2_NM}"
                                        Header="DTRL2_NM" />
                    <DataGridTextColumn Width="120"
                                        Binding="{Binding DTRL3_NM}"
                                        Header="DTRL3_NM" />
                    <DataGridTextColumn Width="120"
                                        Binding="{Binding DTRL4_NM}"
                                        Header="DTRL4_NM" />
                    <DataGridTextColumn Width="120"
                                        Binding="{Binding DTRL5_NM}"
                                        Header="DTRL5_NM" />
                    <DataGridTextColumn Width="120"
                                        Binding="{Binding DTRL6_NM}"
                                        Header="DTRL6_NM" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <!--  row 1 col 3  -->
        <GridSplitter Grid.Row="0"
                      Grid.RowSpan="2"
                      Grid.Column="3"
                      Width="5"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" />
        <!--  row 1 col 4  -->
        <Grid Grid.Row="1"
              Grid.Column="4"
              Background="#F0F0F0">
            <DataGrid>
                <DataGrid.Columns>
                    <DataGridTextColumn Width="50"
                                        Binding="{Binding OWNER}"
                                        Header="OWNER" />
                    <DataGridTextColumn Width="*"
                                        Binding="{Binding OBJ_NAME}"
                                        Header="OBJ NAME" />
                    <DataGridTextColumn Width="80"
                                        Binding="{Binding OBJ_TYPE}"
                                        FontSize="10"
                                        Header="OBJ TYPE" />
                    <DataGridTextColumn Width="50"
                                        Binding="{Binding STATUS}"
                                        FontSize="10"
                                        Header="STATUS" />
