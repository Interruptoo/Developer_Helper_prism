<UserControl x:Class="UserSetting.Views.SettingMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UserSetting.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700"
             d:DesignWidth="200"
             mc:Ignorable="d">

    <StackPanel Style="{StaticResource ThemeStackpanel}">
        <ItemsControl ItemsSource="{Binding MenuCollection}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ListBox>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Image Width="30"
                                       Height="30"
                                       Source="{Binding MenuIcon}" />
                                <TextBlock Margin="5,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding MenuTitle}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>


</UserControl>
