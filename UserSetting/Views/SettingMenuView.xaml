<UserControl x:Class="UserSetting.Views.SettingMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UserSetting.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="200">

    <StackPanel Style="{StaticResource ThemeStackpanel}">
        <ItemsControl ItemsSource="{Binding MenuCollection}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ListBox>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Image Width="30" Height="30" Source="{Binding MenuIcon}" />
                                <TextBlock Text="{Binding MenuTitle}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
    
    
</UserControl>
